{
  "name": "lyricwave",
  "version": "1.0.0",
  "description": "Real-time synchronized lyrics companion with OLED reel visualizer across Spotify, Microphone, Last.fm, and Search.",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron desktop/main.cjs",
    "build": "echo Static site ready",
    "test": "node test-architecture.js && node test-lyrics.js && node test-mic.js && node test-providers.js && node test-shazam.js && node test-reel.js && node test-sources.js && node test-regressions.js && node test-phone.js && node test-audio-reactive.js && node test-visuals.js && node test-card.js && node test-translate.js && node test-android-assets.js",
    "test:e2e": "playwright test",
    "dev": "wrangler pages dev . --ip 127.0.0.1 --port 8788 --compatibility-date=2026-10-06",
    "deploy": "wrangler pages deploy . --project-name lyricwave --branch main",
    "desktop": "electron desktop/main.cjs",
    "desktop:build": "electron-builder",
    "desktop:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "app.lyricwave.desktop",
    "productName": "LyricWave",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "**/*",
      "!android/**",
      "!functions/**",
      "!tests/**",
      "!test-*.js",
      "!dist-desktop/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon-512.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icons/icon-512.png",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icons/icon-512.png",
      "category": "Audio"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "wrangler": "^4.0.0"
  },
  "license": "MIT"
}
